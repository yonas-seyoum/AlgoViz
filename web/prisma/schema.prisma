// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Application user roles supported by the platform
enum Role {
  JOB_SEEKER
  RECRUITER
  ADMIN
}

/// Status for job postings
enum JobStatus {
  OPEN
  CLOSED
  DRAFT
}

/// Status for a job application lifecycle
enum ApplicationStatus {
  APPLIED
  IN_REVIEW
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  role          Role     @default(JOB_SEEKER)
  passwordHash  String?
  headline      String?
  location      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  companyId     String?
  company       Company? @relation("CompanyUsers", fields: [companyId], references: [id])

  resumes       Resume[]
  applications  Application[]
  savedJobs     SavedJob[]
  sentMessages  Message[] @relation("SentMessages")

  // Messaging threads
  threadsAsRecruiter Thread[] @relation("RecruiterThreads")
  threadsAsCandidate Thread[] @relation("CandidateThreads")

  // Jobs posted by this user (recruiter)
  postedJobs    Job[]    @relation("UserPostedJobs")

  // Companies this user owns (as recruiter/owner)
  ownedCompanies Company[] @relation("CompanyOwner")

  interviewSessions InterviewSession[]

  // NextAuth relations
  accounts      Account[]
  sessions      Session[]
  authenticators Authenticator[]
}

model Company {
  id           String  @id @default(cuid())
  name         String
  website      String?
  description  String?
  logoUrl      String?
  ownerUserId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  owner        User?    @relation("CompanyOwner", fields: [ownerUserId], references: [id])
  users        User[]   @relation("CompanyUsers")
  jobs         Job[]
}

model Job {
  id             String     @id @default(cuid())
  title          String
  description    String
  location       String?
  employmentType String?    // Full-time, Part-time, Contract, Internship
  salaryMin      Int?
  salaryMax      Int?
  externalUrl    String?
  status         JobStatus  @default(OPEN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  companyId      String?
  postedByUserId String?

  // Relations
  company        Company?   @relation(fields: [companyId], references: [id])
  postedBy       User?      @relation("UserPostedJobs", fields: [postedByUserId], references: [id])
  applications   Application[]

  // Reverse relations
  savedBy        SavedJob[]
  threads        Thread[]
}

model Resume {
  id          String   @id @default(cuid())
  userId      String
  title       String
  // raw JSON representation of structured resume content
  data        Json?
  // optional URL if uploaded as a file
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [userId], references: [id])
  applications Application[]
}

model Application {
  id           String            @id @default(cuid())
  userId       String
  jobId        String
  resumeId     String?
  status       ApplicationStatus @default(APPLIED)
  coverLetter  String?
  atsScore     Int?              // AI-computed ATS score snapshot
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relations
  user         User              @relation(fields: [userId], references: [id])
  job          Job               @relation(fields: [jobId], references: [id])
  resume       Resume?           @relation(fields: [resumeId], references: [id])
}

/// Saved jobs can reference internal jobs or external jobs from integrators
model SavedJob {
  id            String   @id @default(cuid())
  userId        String
  jobId         String?
  // External job fields
  externalId    String?
  source        String?  // e.g., JSearch, PRLabs
  externalUrl   String?
  title         String?
  companyName   String?
  location      String?
  createdAt     DateTime @default(now())

  // Relations
  user          User     @relation(fields: [userId], references: [id])
  job           Job?     @relation(fields: [jobId], references: [id])

  @@index([userId])
  @@index([externalId, source])
}

model Thread {
  id               String   @id @default(cuid())
  recruiterUserId  String
  candidateUserId  String
  jobId            String?
  createdAt        DateTime @default(now())

  recruiter        User     @relation("RecruiterThreads", fields: [recruiterUserId], references: [id])
  candidate        User     @relation("CandidateThreads", fields: [candidateUserId], references: [id])
  job              Job?     @relation(fields: [jobId], references: [id])
  messages         Message[]

  @@index([recruiterUserId])
  @@index([candidateUserId])
}

model Message {
  id           String   @id @default(cuid())
  threadId     String
  senderUserId String
  content      String
  createdAt    DateTime @default(now())

  thread       Thread   @relation(fields: [threadId], references: [id])
  sender       User     @relation("SentMessages", fields: [senderUserId], references: [id])

  @@index([threadId])
}

model InterviewSession {
  id         String   @id @default(cuid())
  userId     String
  jobTitle   String?
  questions  Json?
  answers    Json?
  score      Int?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  @@index([userId])
}

// NextAuth.js models (Prisma Adapter)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  oauth_token_secret String?
  oauth_token       String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @id
  userId               String
  credentialPublicKey  Bytes
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
